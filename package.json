{
  "name": "@nhtanvir/statelint",
  "version": "0.1.0",
  "description": "Conformance linter and migration tool for stateless MCP (Model Context Protocol 2026-07-28): checks the removed initialize handshake and Mcp-Session-Id, Mcp-Method / Mcp-Name header-body agreement (-32020 HeaderMismatch), server/discover and cache hints, scores a server 0-100, and rewrites TypeScript SDK servers to createMcpHandler. Zero dependencies.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "stateless-mcp",
    "mcp-2026-07-28",
    "mcp-conformance",
    "conformance",
    "conformance-testing",
    "mcp-server",
    "mcp-testing",
    "mcp-migration",
    "migration",
    "codemod",
    "linter",
    "streamable-http",
    "mcp-method",
    "mcp-name",
    "header-mismatch",
    "createmcphandler",
    "mcp-security",
    "ai-agents",
    "developer-tools",
    "cli",
    "github-action"
  ],
  "license": "MIT",
  "author": "NHTanvir",
  "homepage": "https://github.com/NHTanvir/statelint#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NHTanvir/statelint.git"
  },
  "bugs": {
    "url": "https://github.com/NHTanvir/statelint/issues"
  },
  "type": "module",
  "bin": {
    "statelint": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build && npm run build:test && node --test build/test/*.test.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "demo": "node dist/cli.js demo"
  },
  "devDependencies": {
    "@types/node": "18.19.130",
    "typescript": "5.9.3"
  }
}
